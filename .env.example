# Copy file này thành .env rồi chỉnh (không commit .env)

# "Não" của nhân vật: ollama (model local, miễn phí) hoặc claude (Claude API, cần key)
LLM_PROVIDER=ollama

# ---- Ollama (local) ----
# Cài Ollama ở ollama.com rồi chạy: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
# Tắt chế độ "suy nghĩ" của Qwen 3 để trả lời nhanh (để trống nếu model không hỗ trợ và bị báo lỗi)
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.8

# ---- Claude API ----
ANTHROPIC_API_KEY=
# Model mặc định; đổi nếu muốn (vd claude-sonnet-5-5 nhanh/rẻ hơn)
CLAUDE_MODEL=claude-opus-5-5
# low = trả lời nhanh, hợp chat; tăng lên medium/high nếu muốn sâu hơn
CLAUDE_EFFORT=low

# ---- Giọng nói (TTS, chạy CPU) ----
# vieneu (mặc định, giọng tự nhiên, CPU), piper (nhẹ hơn, giọng cứng) hoặc none để tắt hẳn
TTS_PROVIDER=vieneu
# Giọng VieNeu: Mỹ Duyên (mặc định), Trúc Ly, Thục Đoan, Đoan Trang, Kim Thanh... Lần đầu tự tải model (~vài trăm MB)
VIENEU_VOICE=Mỹ Duyên
# fp32 (mặc định) hoặc int8 (trên máy này không nhanh hơn rõ, nạp lâu hơn)
VIENEU_PRECISION=fp32
# Piper (khi TTS_PROVIDER=piper). Tải giọng: uv run python scripts/get_voice.py
PIPER_VOICE=models/piper/vi_VN-vais1000-medium.onnx
# >1 đọc chậm hơn, <1 nhanh hơn
PIPER_LENGTH_SCALE=1.0

# ---- Nghe giọng nói (STT) ----
# whisper (mặc định) hoặc none để tắt nút mic
STT_PROVIDER=whisper
# small (mặc định) / base (nhanh hơn, kém chính xác hơn) / medium (chậm, cần nhiều RAM hơn)
WHISPER_MODEL=small
# cpu (mặc định, không tốn VRAM, ~1,25s/câu) hoặc cuda (~0,25s/câu nhưng cần cuBLAS/cuDNN và VRAM trống)
WHISPER_DEVICE=cpu
WHISPER_THREADS=12
