{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "waifu-dev",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "waifu-test",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PROACTIVE_GREETING=false&& set MEMORY_ENABLED=false&& uv run uvicorn app.main:app --port 8001"
      ],
      "port": 8001
    }
  ]
}
